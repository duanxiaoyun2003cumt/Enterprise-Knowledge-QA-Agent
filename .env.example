# DeepSeek official API (OpenAI-compatible).
# Copy this file to .env and replace the API key placeholder.
# .env is git-ignored. Never commit real credentials.

# Required: DeepSeek API key from https://platform.deepseek.com/api_keys
LLM_API_KEY=replace-with-your-deepseek-api-key

# Required: DeepSeek official OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.deepseek.com

# Required: deepseek-flash (recommended) or deepseek-v4-pro.
LLM_MODEL=deepseek-flash

# Optional: request timeout in seconds (default: 30). DeepSeek thinking mode
# is enabled by default, so 60 is a safer value.
LLM_TIMEOUT=60
